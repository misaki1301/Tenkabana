<Window x:Class="Tenkabana.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available"
        Width="640" Height="580" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType">

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock x:Name="HeaderText" Style="{StaticResource SubtitleText}"/>
      <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Changelog for every release between the running version and this one -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
      <FlowDocumentScrollViewer x:Name="NotesViewer" IsToolBarVisible="False"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"/>
    </Border>

    <StackPanel Grid.Row="2" x:Name="ProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
      <ProgressBar x:Name="DownloadProgress" Style="{StaticResource ThinProgress}"
                   Minimum="0" Maximum="100" Value="0"/>
      <TextBlock x:Name="ProgressText" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Button x:Name="SkipButton" Content="Skip this version" Style="{StaticResource StandardButton}"
              HorizontalAlignment="Left" Click="OnSkip"
              ToolTip="Don't remind me about this version. Check for updates still finds it."/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="LaterButton" Content="Later" Style="{StaticResource StandardButton}"
                Click="OnLater" Margin="0,0,8,0" IsCancel="True"/>
        <Button x:Name="UpdateButton" Content="Update and restart" Style="{StaticResource AccentButton}"
                Click="OnUpdate" IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
