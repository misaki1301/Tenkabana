<Window x:Class="Tenkabana.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tenkabana"
        Height="880" Width="1480" MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType">

  <Grid Margin="24,16,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Tenkabana" Style="{StaticResource TitleText}"/>
        <TextBlock x:Name="SubtitleLabel" Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                   Text="Loading index..."/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="RefreshButton" Content="Refresh index" Style="{StaticResource StandardButton}"
                Click="OnRefresh" Margin="0,0,8,0"/>
        <Button x:Name="OpenOutButton" Content="Open output" Style="{StaticResource StandardButton}"
                Click="OnOpenOutput"/>
      </StackPanel>
    </Grid>

    <!-- Filters -->
    <Grid Grid.Row="1" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="ChipMesh" Content="Meshes" Style="{StaticResource Chip}" IsChecked="True" Click="OnFilterChanged"/>
        <ToggleButton x:Name="ChipTex" Content="Textures" Style="{StaticResource Chip}" IsChecked="True" Click="OnFilterChanged"/>
        <ToggleButton x:Name="ChipAnim" Content="Animations" Style="{StaticResource Chip}" Click="OnFilterChanged"/>
        <ToggleButton x:Name="ChipOther" Content="Other" Style="{StaticResource Chip}" IsChecked="True" Click="OnFilterChanged"/>
        <Border Width="1" Margin="8,2,12,2" Background="{DynamicResource StrokeStrong}"/>
        <ToggleButton x:Name="ChipShared" Content="Shared costumes" Style="{StaticResource Chip}"
                      Click="OnFilterChanged"
                      ToolTip="Outfits whose code is not tied to an idol id (hllw03, bridal, ovcm01...). Any character can wear these, so idol-name matching never finds them."/>
        <ToggleButton x:Name="ChipBlender" Content="Convert for Blender" Style="{StaticResource Chip}"
                      IsChecked="True" Click="OnFilterChanged"
                      ToolTip="After exporting, decode the bundles to meshes/*.obj and textures/*.png so Blender can open them. OBJ carries no rig - use AssetRipper on the bundles if you need bones and blendshapes."/>
        <ToggleButton x:Name="ChipDeps" Content="Include meshes (resolve dependencies)"
                      Style="{StaticResource Chip}" IsChecked="True" Click="OnFilterChanged"
                      ToolTip="Mesh assets are named generically, so geometry is only reachable by following each prefab's bundle references."/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Select all" Style="{StaticResource StandardButton}" Padding="12,5"
                FontSize="12" Click="OnSelectAll" Margin="0,0,8,0"/>
        <Button Content="Clear" Style="{StaticResource StandardButton}" Padding="12,5"
                FontSize="12" Click="OnClearSelection"/>
      </StackPanel>
    </Grid>

    <!-- Characters | asset list | preview -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="532"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*" MinWidth="300"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,16,8,8">
        <!-- No outer ScrollViewer: a ListBox inside one grows to full content
             height, so its internal ScrollViewer has nothing to scroll but still
             marks the wheel event handled - and the wheel does nothing. -->
          <ListBox x:Name="IdolList" Background="Transparent" BorderThickness="0"
                   SelectionMode="Multiple"
                   ItemContainerStyle="{StaticResource IdolTile}"
                   SelectionChanged="OnSelectionChanged"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.CanContentScroll="False"
                   ScrollViewer.PanningMode="VerticalOnly">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Width="150" CornerRadius="8" Background="{DynamicResource LayerAlt}"
                        BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                  <StackPanel>
                    <Grid Height="132">
                      <Border CornerRadius="7,7,0,0" Background="{Binding Gradient}"/>
                      <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource DisplayFont}"
                                 FontSize="52" FontWeight="SemiBold" Foreground="#38FFFFFF"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Image Source="{Binding Portrait}" Stretch="UniformToFill"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Border Background="#33000000" CornerRadius="4" Padding="5,1"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0">
                        <TextBlock Text="{Binding IdText}" FontSize="10" Foreground="White"
                                   FontFamily="{StaticResource TextFont}"/>
                      </Border>
                    </Grid>
                    <StackPanel Margin="10,8,10,10">
                      <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}"
                                 FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding JpName}" Style="{StaticResource CaptionText}"
                                 TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                      <TextBlock Text="{Binding CountText}" Style="{StaticResource CaptionText}"
                                 Opacity="0.75" Margin="0,4,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
      </Border>

      <!-- Asset list -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="AssetListHeader" Style="{StaticResource BodyText}"
                       FontWeight="SemiBold" Text="Assets" Margin="2,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="ExportSelectedButton" Content="Export selected"
                      Style="{StaticResource StandardButton}" Padding="10,4" FontSize="11"
                      Click="OnExportSelected" IsEnabled="False" Margin="0,0,6,0"
                      ToolTip="Export just the selected asset, with its dependencies - so a hair prefab arrives with its mesh and texture."/>
              <Button x:Name="ExportCostumeButton" Content="Export costume"
                      Style="{StaticResource StandardButton}" Padding="10,4" FontSize="11"
                      Click="OnExportCostume" IsEnabled="False"
                      ToolTip="Export every asset of the selected costume - dress, accessories, hair, costume-specific face and eye maps - plus their meshes."/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" CornerRadius="5" Background="{DynamicResource LayerAlt}"
                  BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="1"
                  Padding="8,5" Margin="0,0,0,8">
            <TextBox x:Name="AssetSearch" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                     FontFamily="{StaticResource TextFont}" FontSize="12"
                     TextChanged="OnAssetSearchChanged"/>
          </Border>
          <ListBox Grid.Row="2" x:Name="AssetList" Background="Transparent" BorderThickness="0"
                   SelectionMode="Single" SelectionChanged="OnAssetSelected"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   IsSynchronizedWithCurrentItem="False"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource LayerAlt}" CornerRadius="4"
                            Padding="8,4" Margin="0,8,0,4">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                   FontFamily="{StaticResource TextFont}"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" FontSize="11"
                                   FontFamily="{StaticResource TextFont}"
                                   Foreground="{DynamicResource TextSecondary}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="bg" CornerRadius="5" Padding="8,6" Background="Transparent">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="bg" Property="Background" Value="{DynamicResource LayerAlt}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="bg" Property="Background" Value="{DynamicResource Accent}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontSize="12"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding KindText}" Style="{StaticResource CaptionText}"
                             FontSize="10" Opacity="0.8"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Preview -->
      <Border Grid.Column="4" Style="{StaticResource Card}" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border x:Name="MeshPickerHost" Grid.Row="0" Visibility="Collapsed"
                  CornerRadius="5" Background="{DynamicResource LayerAlt}"
                  BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="1"
                  Padding="8,4" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Mesh" Style="{StaticResource CaptionText}"
                         VerticalAlignment="Center" Margin="2,0,10,0"/>
              <ComboBox Grid.Column="1" x:Name="MeshPicker" SelectionChanged="OnMeshPicked"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextPrimary}"
                        FontFamily="{StaticResource TextFont}" FontSize="12"/>
            </Grid>
          </Border>

          <Border Grid.Row="1" CornerRadius="6" Background="{DynamicResource LayerAlt}" ClipToBounds="True">
            <Grid>
              <!-- checkerboard hint for alpha -->
              <Image x:Name="PreviewImage" Stretch="Uniform" Margin="12"
                     RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>

              <Grid x:Name="ViewportHost" Visibility="Collapsed" Background="Transparent"
                    MouseLeftButtonDown="OnViewportMouseDown"
                    MouseMove="OnViewportMouseMove"
                    MouseWheel="OnViewportWheel">
              <Viewport3D x:Name="PreviewViewport">
                <Viewport3D.Camera>
                  <PerspectiveCamera x:Name="PreviewCamera" Position="0,0,3"
                                     LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="45"/>
                </Viewport3D.Camera>
                <ModelVisual3D>
                  <ModelVisual3D.Content>
                    <Model3DGroup x:Name="PreviewModelGroup">
                      <AmbientLight Color="#585858"/>
                      <DirectionalLight Color="#C8C8C8" Direction="-0.4,-0.6,-1"/>
                      <DirectionalLight Color="#4A4A4A" Direction="0.7,0.3,0.6"/>
                    </Model3DGroup>
                  </ModelVisual3D.Content>
                </ModelVisual3D>
              </Viewport3D>
              </Grid>

              <TextBlock x:Name="PreviewPlaceholder" Style="{StaticResource CaptionText}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280"
                         Text="Select a character, then an asset to preview it."/>

              <Border x:Name="PreviewBusy" Background="#66000000" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="Decoding…" Style="{StaticResource BodyText}"
                             HorizontalAlignment="Center"/>
                  <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True"
                               Width="140" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <TextBlock Grid.Row="2" x:Name="PreviewInfo" Style="{StaticResource CaptionText}"
                     Margin="2,10,2,0" TextTrimming="CharacterEllipsis" Text=""/>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Output" Style="{StaticResource BodyText}"
                     VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.7"/>
          <Border Grid.Column="1" CornerRadius="5" Background="{DynamicResource LayerAlt}"
                  BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="1"
                  Padding="10,6" VerticalAlignment="Center">
            <TextBlock x:Name="OutputPathLabel" Style="{StaticResource BodyText}"
                       TextTrimming="CharacterEllipsis" Text="..."/>
          </Border>
          <Button Grid.Column="2" Content="Browse" Style="{StaticResource StandardButton}"
                  Click="OnBrowse" Margin="8,0,8,0"/>
          <Button Grid.Column="3" x:Name="ExtractButton" Content="Extract"
                  Style="{StaticResource AccentButton}" Click="OnExtract" IsEnabled="False"
                  Padding="28,7"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,12,0,0">
          <ProgressBar x:Name="Progress" Style="{StaticResource ThinProgress}"
                       Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
          <TextBlock x:Name="StatusLabel" Style="{StaticResource CaptionText}"
                     Text="Select one or more characters." VerticalAlignment="Center"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
